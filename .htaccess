Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:app|includes|sql|tests|tools|\.runtime)(?:/|$) - [F,L]
RewriteRule ^(?:config(?:\.example)?\.php|router\.php|README\.md|TESTING\.md)$ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
